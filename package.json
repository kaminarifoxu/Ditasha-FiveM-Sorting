{
  "name": "ditasha-asset-sorter",
  "version": "1.5.0",
  "description": "DITASHA FiveM Asset Sorter — sorting aset, preview model 3D, dan texture reducer",
  "author": "Ditasha-Workshop",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/desktop.test.cjs tests/updater.test.cjs tests/update-startup.test.cjs tests/multi-preview.test.cjs",
    "build:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.ditasha.assetsorter",
    "productName": "DITASHA-Asset-Sorter",
    "copyright": "Copyright © 2026 Ditasha-Workshop",
    "files": [
      "electron/**/*.cjs",
      "ui/**/*",
      "assets/icon.ico",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "DITASHA-Asset-Sorter.exe",
      "useZip": true
    }
  }
}
